#!/bin/bash
set -euxo pipefail

# ---------- k3s ----------
# Pinned release; kubeconfig readable so kubectl works for the SSM user.
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - \
  --write-kubeconfig-mode 644
echo 'export KUBECONFIG=/etc/rancher/k3s/k3s.yaml' > /etc/profile.d/k3s.sh

# ---------- Tools ----------
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
# snapd may still be seeding right after boot ("unable to contact snap
# store"), which aborted this script in the second test session: wait for
# the seed and retry instead of failing.
snap wait system seed.loaded || true
for attempt in 1 2 3 4 5 6; do
  snap install aws-cli --classic && break
  echo "snap install failed (attempt $attempt), retrying in 10s"
  sleep 10
done
command -v aws

# ---------- ECR pull secret ----------
# ECR tokens expire after 12 hours. A systemd timer refreshes the
# image pull secret every 6 hours using the node's IAM role.
cat > /usr/local/bin/refresh-ecr-secret <<'SCRIPT'
#!/bin/bash
set -euo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
REGION="$${AWS_REGION:-us-east-1}"
ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
REGISTRY="$ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com"
PASSWORD=$(aws ecr get-login-password --region "$REGION")
for NAMESPACE in $${NAMESPACES:-orders sre-agent}; do
  kubectl get namespace "$NAMESPACE" >/dev/null 2>&1 || continue
  kubectl -n "$NAMESPACE" create secret docker-registry ecr-pull \
    --docker-server="$REGISTRY" --docker-username=AWS --docker-password="$PASSWORD" \
    --dry-run=client -o yaml | kubectl apply -f -
done
SCRIPT
chmod +x /usr/local/bin/refresh-ecr-secret

cat > /etc/systemd/system/refresh-ecr-secret.service <<'UNIT'
[Unit]
Description=Refresh the ECR image pull secret
[Service]
Type=oneshot
Environment=AWS_REGION=${region}
ExecStart=/usr/local/bin/refresh-ecr-secret
UNIT

cat > /etc/systemd/system/refresh-ecr-secret.timer <<'UNIT'
[Unit]
Description=Refresh the ECR image pull secret every 6 hours
[Timer]
OnBootSec=2min
OnUnitActiveSec=6h
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now refresh-ecr-secret.timer
